# Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local dev — discrete vars; managed hosts inject DATABASE_URL instead)
DB_NAME=mizan
DB_USER=mizan
DB_PASSWORD=mizan
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# CORS / CSRF (production: the deployed frontend origin, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# AI — Anthropic Claude (Issue 7.3; leave blank until provisioned)
ANTHROPIC_API_KEY=

# OCR provider (Issue 7.2; chosen via Question before integration)
OCR_PROVIDER=
